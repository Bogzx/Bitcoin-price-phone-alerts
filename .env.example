# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# Required. Without it a new random key is generated on every restart, which
# logs out every user and voids every remember-me cookie.
SECRET_KEY=change_me_to_a_long_random_string
DATABASE_URL=sqlite:///alerts.db

# Set true to log alerts instead of calling (no Twilio account needed).
NOTIFY_DRY_RUN=false
TWILIO_ACCOUNT_SID=example_sid
TWILIO_AUTH_TOKEN=example_token
TWILIO_PHONE_NUMBER=+example_number

# Set to false when serving over plain HTTP (e.g. http://localhost:5000),
# otherwise the browser will not store the session cookie and login appears to fail.
SESSION_COOKIE_SECURE=true

# Abuse / spend limits. Every alert is a billable phone call.
MAX_ACTIVE_ALERTS_PER_USER=5
NOTIFY_COOLDOWN_SECONDS=300
REPEAT_ALERT_COOLDOWN_SECONDS=900
# Deployment-wide cap on calls/SMS in any rolling 24h; "both" counts as 2 (0 = no cap).
MAX_NOTIFICATIONS_PER_DAY=50
# Only the first account may register unless this is true. Phone numbers are
# not verified, so every account can make you pay to call any number.
ALLOW_REGISTRATION=false
# A repeating alert re-arms after the price retreats this % of the threshold.
REARM_HYSTERESIS_PERCENT=0.25
# Optional E.164 country code allowlist, e.g. "1,44,40". Empty means any country,
# which is the widest toll-fraud surface.
ALLOWED_PHONE_COUNTRY_CODES=

# The Binance feed must run in exactly one process (see README "Status").
RUN_PRICE_FEED=true
PRICE_FEED_LOCK_PORT=29653
# stream.binance.com returns HTTP 451 to US IPs; in the US use
# wss://stream.binance.us:9443/ws/btcusdt@trade
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
# Seconds without a trade before the socket is recycled / healthz reports stale.
FEED_STALE_SECONDS=60
LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
